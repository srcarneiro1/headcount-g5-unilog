    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-11-01"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "jose": "^6.0.8",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  }
}
